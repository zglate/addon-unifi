#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community Add-on: UniFi Network Application
# Runs the nginx reverse proxy that renders the UniFi UI in the HA sidebar
# ==============================================================================

if bashio::config.true 'ingress'; then
    bashio::log.info \
        'Inline ingress enabled: UniFi UI will render in the Home Assistant sidebar.'
    ln -sf /etc/nginx/ingress-proxy.conf /etc/nginx/active-server.conf
else
    bashio::log.info \
        "Inline ingress disabled. Enable the 'ingress' option to render UniFi in the sidebar."
    ln -sf /etc/nginx/ingress-disabled.conf /etc/nginx/active-server.conf
fi

exec nginx
