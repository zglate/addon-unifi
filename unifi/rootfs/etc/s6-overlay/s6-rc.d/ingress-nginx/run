#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community Add-on: UniFi Network Application
# Runs the nginx reverse proxy that renders the UniFi UI in the HA sidebar
# ==============================================================================

bashio::log.info \
    'Starting ingress proxy: the UniFi UI is available in the Home Assistant sidebar.'
ln -sf /etc/nginx/ingress-proxy.conf /etc/nginx/active-server.conf

# Ingress base-path canary. This proxy rewrites a small set of content literals
# in the UniFi bundles so the SPA works behind HA's path prefix. The literals
# are stable across bundle-hash renames but a new UniFi version could change
# them. If any is missing, warn loudly: the sidebar UI will break, but
# direct-port access on 8443 is unaffected.
readonly WEBAPP="/usr/lib/unifi/webapps/ROOT/app-unifi"
declare -a ingress_literals=(
    '<base href="/manage/">'
    'BASE_HREF:"/manage/"'
    'apiAdapter:new i.default("/")'
    'baseUrl="/manage/"'
    'baseURL:"/",withCredentials'
    '.p="/setup/"'
)
for literal in "${ingress_literals[@]}"; do
    if ! grep -rqF "${literal}" "${WEBAPP}" 2>/dev/null; then
        bashio::log.warning \
            "Ingress canary: literal not found in UniFi bundles -> [${literal}]." \
            "The sidebar UI may render incorrectly; ingress-proxy.conf needs updating for this UniFi version."
    fi
done

exec nginx
