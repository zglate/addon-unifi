#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community Add-on: UniFi Network Application
# Surface an unexpected exit of the ingress sidebar proxy (nginx) WITHOUT taking
# the container down.
#
# The sibling `unifi` service's finish halts the whole supervision tree on
# failure, because the UniFi app on 8443 is the add-on's reason to exist. The
# inline sidebar is a convenience layered on top: nginx dying must never kill
# the 8443 UI. So this deliberately does NOT halt — it logs loudly and lets s6
# restart nginx, which keeps the sidebar self-healing while making a persistent
# failure visible in the add-on log instead of a silent restart loop.
# ==============================================================================
readonly exit_code_service="${1}"
readonly exit_code_signal="${2}"

# 256 == terminated by a signal; signal 15 (SIGTERM) is the normal add-on
# shutdown path. Stay quiet and let the container come down cleanly.
if [[ "${exit_code_service}" -eq 256 && "${exit_code_signal}" -eq 15 ]]; then
    exit 0
fi

bashio::log.warning \
    "Ingress sidebar proxy exited unexpectedly (code ${exit_code_service}, signal ${exit_code_signal}); s6 will restart it." \
    "The UniFi UI on port 8443 is unaffected; only the Home Assistant sidebar view is briefly interrupted."
